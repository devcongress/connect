<% page_title = @selected_skill ? "#{@selected_skill.name} developers and companies" : "Developers" %>
<% page_description = @selected_skill&.canonical_description || "Browse developers in the DevCongress community: skills, experience and availability." %>
<% content_for :title, page_title %>
<% content_for :description, page_description %>
<% if @selected_skill %>
  <% content_for :noindex, true unless @selected_skill.content_curated? %>
  <% canonical_page = params[:page].to_i > 1 ? {page: params[:page]} : {} %>
  <% content_for :canonical_url, technical_skill_url(@selected_skill, **canonical_page) %>
<% end %>
<% filtered = params.values_at(:q, :skill, :country, :availability, :remote, :experience).any?(&:present?) %>

<section class="border-b-2 border-[#111]">
  <div class="dc-container py-16 sm:py-20">
    <% if @selected_skill %>
      <p class="dc-eyebrow">Technical skill<%= " · #{@selected_skill.category}" if @selected_skill.category.present? %></p>
      <h1 class="dc-heading text-[clamp(2.5rem,6vw,4rem)]"><%= @selected_skill.name %></h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-[#444]"><%= @selected_skill.canonical_description %></p>
      <p class="mt-3 max-w-3xl leading-7 text-[#555]">
        <%= @selected_skill.canonical_why_description %>
        <% if @selected_skill.company_examples.any? %>
          Companies using <%= @selected_skill.name %> include
          <%= safe_join(@selected_skill.company_examples.map { |company| link_to("#{company.fetch("name")} ↗", company.fetch("url"), class: "dc-link font-semibold", target: "_blank", rel: "noopener") }, ", ") %>.
        <% end %>
      </p>
      <% if @selected_skill.website_url.present? || @selected_skill.source_url.present? %>
        <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold">
          <% if @selected_skill.website_url.present? %>
            <%= link_to "Official website ↗", @selected_skill.website_url, class: "dc-link", target: "_blank", rel: "noopener" %>
          <% end %>
          <% if @selected_skill.source_url.present? %>
            <% source_label = @selected_skill.source_url.include?("github.com") ? "GitHub ↗" : "Source repository ↗" %>
            <%= link_to source_label, @selected_skill.source_url, class: "dc-link", target: "_blank", rel: "noopener" %>
          <% end %>
        </div>
      <% end %>
      <p class="mt-3 max-w-3xl text-sm text-[#666]">
        <%= current_user ? "Explore members who list #{@selected_skill.name} and companies using it." : "Explore public profiles that list #{@selected_skill.name} and companies using it. Sign in to see members-only profiles too." %>
      </p>
    <% else %>
      <p class="dc-eyebrow">The community</p>
      <h1 class="dc-heading text-[clamp(2.5rem,6vw,4rem)]">Developers</h1>
      <p class="mt-4 max-w-2xl text-[#555]">
        <%= current_user ? "Everyone who's chosen to be visible to members or the public." : "Developers who've made their profiles public. Sign in to see members-only profiles too." %>
      </p>
    <% end %>

    <%= form_with url: developers_directory_path, method: :get, class: "mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr_auto] lg:items-end", data: {turbo_action: "advance"} do %>
      <label class="block sm:col-span-2 lg:col-span-1">
        <span class="dc-label">Search</span>
        <input type="search" name="q" value="<%= params[:q] %>" placeholder="Name, skill, headline or city" class="dc-input">
      </label>
      <%= render "site/shared/filter_select", name: :skill, label: "Skill", all: "Any skill", choices: @skills.map { [_1.name, _1.slug] } %>
      <%= render "site/shared/filter_select", name: :country, label: "Country", all: "Anywhere", choices: @countries %>
      <%= render "site/shared/filter_select", name: :availability, label: "Availability", all: "Anyone", choices: [["Open to work", "looking"], ["Open to offers", "open"]] %>
      <div class="flex flex-wrap items-center gap-4 lg:pb-2">
        <label class="flex items-center gap-2 text-sm font-medium">
          <input type="checkbox" name="experience" value="1" <%= "checked" if params[:experience] == "1" %> onchange="this.form.requestSubmit()" class="h-4 w-4 accent-[#e8117f]"> Has experience
        </label>
        <label class="flex items-center gap-2 text-sm font-medium">
          <input type="checkbox" name="remote" value="1" <%= "checked" if params[:remote] == "1" %> onchange="this.form.requestSubmit()" class="h-4 w-4 accent-[#e8117f]"> Remote OK
        </label>
        <button type="submit" class="dc-btn dc-btn-primary dc-btn-sm">Search</button>
      </div>
    <% end %>
  </div>
</section>

<section class="dc-container py-12">
  <% if @selected_skill %>
    <% developers_tab_path = technical_skill_path(@selected_skill, **request.query_parameters.except("tab", "page")) %>
    <% companies_tab_path = technical_skill_path(@selected_skill, **request.query_parameters.except("page").merge("tab" => "companies")) %>
    <div class="dc-tabs-row mb-8">
      <nav class="dc-tabs" role="tablist" aria-label="<%= @selected_skill.name %> results">
        <%= link_to developers_tab_path, class: "dc-tab", role: "tab", aria: {selected: @results_tab == :developers, current: ("page" if @results_tab == :developers), controls: "developers-results"} do %>
          Developers <span class="dc-tab-count"><%= @total %></span>
        <% end %>
        <%= link_to companies_tab_path, class: "dc-tab", role: "tab", aria: {selected: @results_tab == :companies, current: ("page" if @results_tab == :companies), controls: "companies-results"} do %>
          Companies <span class="dc-tab-count"><%= @companies_using_skill.size %></span>
        <% end %>
      </nav>
      <% if filtered %><%= link_to "Clear filters", developers_directory_path, class: "dc-link dc-tabs-action" %><% end %>
    </div>
  <% end %>

  <% if @results_tab == :companies %>
    <div id="companies-results" role="tabpanel" aria-label="Companies">
      <% if @companies_using_skill.any? %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% @companies_using_skill.each do |company| %>
            <%= render "site/companies/company_card", company:, job_count: @company_job_counts.fetch(company.id, 0) %>
          <% end %>
        </div>
      <% else %>
        <div class="dc-empty p-12">
          <p class="dc-heading text-3xl">No companies list <%= @selected_skill.name %> yet.</p>
          <p class="mt-2 text-[#555]">Companies can add it to the technologies on their profile.</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div id="developers-results" role="tabpanel" aria-label="Developers">
      <% if @developers.any? %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% @developers.each do |developer| %>
            <%= render "home/developer_card", developer: %>
          <% end %>
        </div>
        <%= render "site/shared/pagination" %>
      <% else %>
        <div class="dc-empty p-12">
          <p class="dc-heading text-3xl">No one matches that yet.</p>
          <p class="mt-2 text-[#555]">Try fewer filters<%= ", or sign in to see members-only profiles" unless current_user %>.</p>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
