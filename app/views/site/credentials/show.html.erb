<% award = @award %>
<% definition = award.definition %>
<% verification_url = public_credential_url(award.public_id) %>
<% content_for :title, "#{definition.name} · #{award.recipient_name}" %>
<% content_for :description, "Verify #{award.recipient_name}'s #{definition.name}, issued by DevCongress." %>
<% structured_data({
     "@context" => "https://schema.org",
     "@type" => "EducationalOccupationalCredential",
     "name" => definition.name,
     "description" => definition.description,
     "credentialCategory" => "Certificate",
     "recognizedBy" => {"@type" => "Organization", "name" => "DevCongress", "url" => "https://devcongress.org/"},
     "about" => {"@type" => "Person", "name" => award.recipient_name},
     "dateCreated" => award.issued_at&.to_date&.iso8601,
     "expires" => award.expires_at&.to_date&.iso8601,
     "identifier" => award.public_id,
     "url" => verification_url
   }.compact) %>

<div class="dc-container max-w-5xl py-10 sm:py-16">
  <header class="grid gap-8 rounded-2xl border-2 border-[#111] bg-white p-6 shadow-[8px_8px_0_#e8117f] md:grid-cols-[220px_1fr] md:p-10">
    <div>
      <%= image_tag credential_badge_path(award.public_id, format: :svg), alt: definition.badge_alt_text,
            class: "aspect-square w-full max-w-[220px] rounded-2xl border-2 border-[#111]" %>
    </div>
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="dc-eyebrow !mb-0">Verified DevCongress credential</span>
        <% status_classes = {"active" => "bg-emerald-100 text-emerald-800", "expired" => "bg-amber-100 text-amber-900", "revoked" => "bg-red-100 text-red-800"} %>
        <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide <%= status_classes.fetch(award.status) %>"><%= award.status %></span>
      </div>
      <h1 class="dc-heading mt-3 text-4xl sm:text-5xl"><%= definition.name %></h1>
      <p class="mt-3 text-xl font-semibold text-[#333]">Awarded to <%= award.recipient_name %></p>
      <p class="mt-4 max-w-2xl text-[#555]"><%= definition.short_description %></p>

      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
        <div><dt class="font-semibold uppercase tracking-wide text-[#777]">Issued by</dt><dd class="mt-1">DevCongress</dd></div>
        <div><dt class="font-semibold uppercase tracking-wide text-[#777]">Issue date</dt><dd class="mt-1"><%= award.issued_at.to_date.to_fs(:long) %></dd></div>
        <% if award.expires_at %><div><dt class="font-semibold uppercase tracking-wide text-[#777]">Expires</dt><dd class="mt-1"><%= award.expires_at.to_date.to_fs(:long) %></dd></div><% end %>
        <div><dt class="font-semibold uppercase tracking-wide text-[#777]">Credential ID</dt><dd class="mt-1 font-mono"><%= award.public_id %></dd></div>
      </dl>
    </div>
  </header>

  <% unless award.active? %>
    <section class="mt-10 rounded-xl border-2 <%= award.revoked? ? "border-red-700 bg-red-50" : "border-amber-700 bg-amber-50" %> p-6" role="status">
      <h2 class="text-xl font-bold">This credential is <%= award.status %>.</h2>
      <% if award.revoked? %><p class="mt-2"><%= award.revoked_reason %></p><% end %>
      <p class="mt-2 text-sm">This verification URL remains available so a previously shared credential never becomes ambiguous.</p>
    </section>
  <% end %>

  <div class="mt-12 grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-10">
      <section>
        <h2 class="dc-heading text-3xl">What this credential recognizes</h2>
        <p class="mt-4 text-[#555]"><%= definition.description %></p>
      </section>

      <section>
        <h2 class="dc-heading text-3xl">Criteria and evidence</h2>
        <h3 class="mt-4 font-semibold">Eligibility criteria</h3>
        <div class="prose mt-2 max-w-none prose-a:text-[#e8117f]"><%= simple_format(definition.eligibility_criteria) %></div>
        <h3 class="mt-5 font-semibold">Evidence reviewed</h3>
        <p class="mt-2 text-[#555]"><%= award.evidence_summary %></p>
        <p class="mt-3 text-sm text-[#777]">Assessed against criteria version <%= award.criteria_version %>.</p>
      </section>

      <section>
        <h2 class="dc-heading text-3xl">What it does not prove</h2>
        <p class="mt-4 text-[#555]"><%= definition.does_not_prove %></p>
      </section>
    </div>

    <aside class="space-y-6">
      <% if award.active? %>
        <section class="rounded-xl border-2 border-[#111] bg-[#fefce8] p-6">
          <h2 class="text-xl font-bold">Add to LinkedIn</h2>
          <p class="mt-2 text-sm text-[#555]">LinkedIn does not prefill certification details. Copy each value below, then open LinkedIn's official form. For the issuer, select <%= link_to "DevCongress's LinkedIn Page", "https://www.linkedin.com/company/28183790/", target: "_blank", rel: "noopener noreferrer", class: "font-semibold text-[#e8117f] underline" %> from LinkedIn's suggestions so the organization logo is attached.</p>
          <dl class="mt-5 space-y-4">
            <% award.linkedin_fields(verification_url:).each do |label, value| %>
              <div data-controller="clipboard" data-clipboard-text-value="<%= value %>">
                <dt class="text-xs font-bold uppercase tracking-wide text-[#777]"><%= label %></dt>
                <dd class="mt-1 flex items-start justify-between gap-3 rounded-lg border border-[#d6d2c6] bg-white px-3 py-2 text-sm">
                  <span class="break-all"><%= value %></span>
                  <button type="button" data-action="clipboard#copy" class="shrink-0 font-semibold text-[#e8117f]"><span data-clipboard-target="label">Copy</span></button>
                </dd>
              </div>
            <% end %>
          </dl>
          <%= link_to "Add to LinkedIn", Credentials::Award::LINKEDIN_ADD_TO_PROFILE_URL,
                target: "_blank", rel: "noopener noreferrer", class: "dc-btn dc-btn-primary mt-6 w-full" %>
          <p class="mt-4 text-xs text-[#666]">This adds a license or certification. It does not create a LinkedIn verification badge or imply LinkedIn endorsement.</p>
        </section>
      <% end %>

      <section class="rounded-xl border-2 border-[#111] bg-white p-6">
        <h2 class="text-xl font-bold">Download and share</h2>
        <div class="mt-4 grid gap-3">
          <%= link_to "Download certificate", credential_certificate_path(award.public_id, format: :svg), class: "dc-btn dc-btn-yellow w-full" %>
          <%= link_to "Download light badge", credential_badge_path(award.public_id, format: :svg), download: "#{definition.slug}-badge.svg", class: "dc-btn dc-btn-white w-full" %>
          <%= link_to "Download dark badge", credential_badge_path(award.public_id, format: :svg, theme: "dark"), download: "#{definition.slug}-badge-dark.svg", class: "dc-btn dc-btn-outline w-full" %>
        </div>
        <p class="mt-4 text-xs text-[#666]">Use the badge only with this verification URL. It represents the achievement above—not employment, a degree, or LinkedIn verification.</p>
      </section>
    </aside>
  </div>
</div>
