<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024" role="img" aria-labelledby="title desc">
  <title id="title"><%= @award.definition.badge_alt_text %></title>
  <desc id="desc">A DevCongress credential badge for <%= @award.definition.name %>.</desc>
  <% dark = @theme == "dark" %>
  <rect width="1024" height="1024" rx="128" fill="<%= dark ? "#111111" : "#f5e642" %>"/>
  <rect x="38" y="38" width="948" height="948" rx="102" fill="none" stroke="<%= dark ? "#f5e642" : "#111111" %>" stroke-width="28"/>
  <circle cx="512" cy="330" r="182" fill="#e8117f" stroke="<%= dark ? "#f5e642" : "#111111" %>" stroke-width="24"/>
  <text x="512" y="390" text-anchor="middle" font-family="Georgia, serif" font-size="176" font-weight="700" fill="#ffffff">d:c</text>
  <text x="512" y="606" text-anchor="middle" font-family="Arial, sans-serif" font-size="58" font-weight="800" letter-spacing="8" fill="<%= dark ? "#ffffff" : "#111111" %>">DEVCONGRESS</text>
  <line x1="190" y1="650" x2="834" y2="650" stroke="<%= dark ? "#f5e642" : "#111111" %>" stroke-width="12"/>
  <text x="512" y="742" text-anchor="middle" font-family="Arial, sans-serif" font-size="54" font-weight="800" fill="<%= dark ? "#f5e642" : "#111111" %>">COMMUNITY</text>
  <text x="512" y="812" text-anchor="middle" font-family="Arial, sans-serif" font-size="54" font-weight="800" fill="<%= dark ? "#f5e642" : "#111111" %>">CONTRIBUTOR</text>
  <text x="512" y="918" text-anchor="middle" font-family="monospace" font-size="28" fill="<%= dark ? "#ffffff" : "#333333" %>"><%= @award.public_id %></text>
</svg>
