<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1120" viewBox="0 0 1600 1120" role="img" aria-labelledby="title desc">
  <title id="title"><%= @award.definition.name %> certificate for <%= @award.recipient_name %></title>
  <desc id="desc">A printable DevCongress certificate with recipient, achievement, issue date, and verification identifier.</desc>
  <rect width="1600" height="1120" fill="#f5f2e8"/>
  <rect x="42" y="42" width="1516" height="1036" rx="28" fill="#ffffff" stroke="#111111" stroke-width="8"/>
  <rect x="42" y="42" width="1516" height="118" rx="28" fill="#f5e642"/>
  <rect x="42" y="132" width="1516" height="28" fill="#f5e642"/>
  <text x="110" y="116" font-family="Georgia, serif" font-size="58" font-weight="700"><tspan fill="#e8117f">dev</tspan><tspan fill="#111111">:</tspan><tspan fill="#555555">congress{};</tspan></text>
  <text x="1490" y="112" text-anchor="end" font-family="Arial, sans-serif" font-size="28" font-weight="700" letter-spacing="5">VERIFIED CREDENTIAL</text>
  <text x="800" y="285" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="700" letter-spacing="7" fill="#777777">DEVCONGRESS RECOGNIZES</text>
  <text x="800" y="405" text-anchor="middle" font-family="Georgia, serif" font-size="82" fill="#111111"><%= @award.recipient_name %></text>
  <line x1="310" y1="450" x2="1290" y2="450" stroke="#e8117f" stroke-width="6"/>
  <text x="800" y="540" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" fill="#555555">for earning the</text>
  <text x="800" y="642" text-anchor="middle" font-family="Georgia, serif" font-size="70" fill="#111111"><%= @award.definition.name %></text>
  <foreignObject x="270" y="695" width="1060" height="130">
    <div xmlns="http://www.w3.org/1999/xhtml" style="font: 28px Arial, sans-serif; line-height: 1.45; text-align: center; color: #555555;"><%= @award.definition.short_description %></div>
  </foreignObject>
  <text x="240" y="940" font-family="Arial, sans-serif" font-size="22" font-weight="700" fill="#777777">ISSUED</text>
  <text x="240" y="982" font-family="Arial, sans-serif" font-size="30" fill="#111111"><%= @award.issued_at.to_date.to_fs(:long) %></text>
  <text x="1360" y="940" text-anchor="end" font-family="Arial, sans-serif" font-size="22" font-weight="700" fill="#777777">CREDENTIAL ID</text>
  <text x="1360" y="982" text-anchor="end" font-family="monospace" font-size="28" fill="#111111"><%= @award.public_id %></text>
  <text x="800" y="1040" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#777777">Verify at <%= public_credential_url(@award.public_id) %></text>
</svg>
