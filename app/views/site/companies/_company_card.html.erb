<% location = [company.city, company.country].compact_blank.join(", ") %>
<% summary = strip_tags(render_markdown(company.description)).squish if company.description.present? %>
<%= link_to public_company_path(company.slug), class: "group dc-box flex h-full flex-col gap-5 p-6" do %>
  <span class="flex items-center gap-4">
    <%= render InitialsAvatar.new(name: company.display_name, seed: company.slug, size: :lg, shape: :square) %>
    <span class="min-w-0">
      <span class="dc-heading block truncate text-2xl transition-colors group-hover:text-[#e8117f]"><%= company.display_name %></span>
      <% if location.present? %><span class="mt-1 block truncate text-sm text-[#555]"><%= location %></span><% end %>
    </span>
  </span>

  <% if summary.present? %>
    <span class="line-clamp-3 flex-1 text-sm leading-6 text-[#555]"><%= truncate(summary, length: 180) %></span>
  <% else %>
    <span class="flex-1 text-sm leading-6 text-[#777]">View this company on DevCongress Connect.</span>
  <% end %>

  <span class="mt-auto flex items-center justify-between gap-3 border-t border-[#dedbd1] pt-4">
    <span class="min-w-0 truncate text-xs text-[#6b6b6b]">
      <%= company.website.present? ? company.website.sub(%r{\Ahttps?://(www\.)?}, "").sub(%r{/\z}, "") : "DevCongress Connect" %>
    </span>
    <span class="flex shrink-0 items-center gap-3">
      <span class="text-xs font-semibold text-[#555]"><%= pluralize(job_count, "open job") %></span>
      <span class="dc-link">View →</span>
    </span>
  </span>
<% end %>
