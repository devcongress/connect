<% content_for :title, "Issue credential" %>

<div class="mx-auto max-w-4xl space-y-6">
  <header>
    <%= link_to "← Credentials", credential_awards_path, class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %>
    <h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]">Issue one credential</h1>
    <p class="mt-1 text-sm text-[var(--pu-text-muted)]">This first step is a preview. It does not create a credential or send an email.</p>
  </header>

  <% if @definition %>
    <section class="pu-card">
      <div class="pu-card-body space-y-3">
        <div class="flex items-start gap-4">
          <%= image_tag "brand/devcongress-dev-square.png", alt: @definition.badge_alt_text, class: "h-20 w-20 rounded-xl border border-[var(--pu-border)]" %>
          <div><h2 class="text-xl font-semibold text-[var(--pu-text)]"><%= @definition.name %></h2><p class="mt-1 text-sm text-[var(--pu-text-muted)]"><%= @definition.short_description %></p></div>
        </div>
        <details class="text-sm"><summary class="cursor-pointer font-semibold">Review criteria and evidence requirements</summary><div class="mt-3 grid gap-4 sm:grid-cols-2"><div><h3 class="font-semibold">Eligibility</h3><%= simple_format(@definition.eligibility_criteria, class: "mt-1 text-[var(--pu-text-muted)]") %></div><div><h3 class="font-semibold">Evidence</h3><%= simple_format(@definition.evidence_requirements, class: "mt-1 text-[var(--pu-text-muted)]") %></div></div></details>
      </div>
    </section>
  <% end %>

  <%= form_with url: preview_credential_awards_path, scope: :credential, class: "pu-card" do |form| %>
    <div class="pu-card-body space-y-5">
      <div>
        <%= form.label :definition_id, "Credential", class: "block font-semibold text-[var(--pu-text)]" %>
        <%= form.collection_select :definition_id, @definitions, :id, :name, {selected: @definition&.id}, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
      </div>
      <div>
        <%= form.label :recipient_identifier, "Recipient", class: "block font-semibold text-[var(--pu-text)]" %>
        <%= form.text_field :recipient_identifier, required: true, placeholder: "Developer handle or account email", class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
        <p class="mt-1 text-xs text-[var(--pu-text-muted)]">The recipient must already have a Connect developer profile.</p>
      </div>
      <div>
        <%= form.label :evidence_summary, "Evidence reviewed", class: "block font-semibold text-[var(--pu-text)]" %>
        <%= form.text_area :evidence_summary, required: true, rows: 5, placeholder: "State the accepted contribution and link or reference the evidence reviewed.", class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
        <p class="mt-1 text-xs text-[var(--pu-text-muted)]">This summary becomes public after consent. Include enough to verify the decision, but no private contact details or internal notes.</p>
      </div>
      <div>
        <%= form.label :expires_at, "Optional expiry", class: "block font-semibold text-[var(--pu-text)]" %>
        <%= form.datetime_local_field :expires_at, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
        <p class="mt-1 text-xs text-[var(--pu-text-muted)]">The Community Contributor credential does not expire by default.</p>
      </div>
    </div>
    <div class="border-t border-[var(--pu-border)] px-6 py-4 text-right"><%= form.submit "Preview credential", class: "pu-btn pu-btn-md pu-btn-primary" %></div>
  <% end %>
</div>
