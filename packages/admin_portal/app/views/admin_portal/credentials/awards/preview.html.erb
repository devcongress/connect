<% content_for :title, "Preview credential" %>

<div class="mx-auto max-w-4xl space-y-6">
  <header>
    <%= link_to "← Change details", new_credential_award_path(definition_id: @definition.id), class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %>
    <h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]">Preview before invitation</h1>
    <p class="mt-1 text-sm text-[var(--pu-text-muted)]">No credential exists yet and no notification has been sent.</p>
  </header>

  <section class="dc-card overflow-hidden">
    <div class="dc-highlight border-b-2 border-[var(--dc-ink)] px-6 py-4 text-sm font-bold uppercase tracking-wide">Credential preview</div>
    <div class="p-6 sm:p-8">
      <span class="pu-badge pu-badge-warning">Pending recipient consent</span>
      <h2 class="mt-4 font-display text-4xl text-[var(--pu-text)]"><%= @definition.name %></h2>
      <p class="mt-2 text-xl font-semibold text-[var(--pu-text)]"><%= @profile.name %></p>
      <p class="mt-1 text-sm text-[var(--pu-text-muted)]">@<%= @profile.handle %> · <%= @profile.user.email %></p>
      <dl class="mt-6 grid gap-5 sm:grid-cols-2">
        <div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Criteria version</dt><dd class="mt-1"><%= @definition.criteria_version %></dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Expiry</dt><dd class="mt-1"><%= @award.expires_at&.to_fs(:long) || "Does not expire" %></dd></div>
        <div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Evidence reviewed</dt><dd class="mt-1"><%= @award.evidence_summary %></dd></div>
      </dl>
    </div>
  </section>

  <% if @award.errors.any? %>
    <div class="rounded-lg border border-red-500 bg-red-50 p-4 text-red-800"><%= @award.errors.full_messages.to_sentence %></div>
  <% else %>
    <section class="pu-card"><div class="pu-card-body"><h2 class="font-semibold text-[var(--pu-text)]">What happens next</h2><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[var(--pu-text-muted)]"><li>The recipient receives an email and sees the invitation in Connect.</li><li>Nothing becomes public until the recipient reviews and accepts it.</li><li>Acceptance issues the credential, publishes the verification URL, and sends a confirmation email.</li></ol></div></section>
    <%= form_with url: credential_awards_path, scope: :credential, class: "text-right" do |form| %>
      <%= form.hidden_field :definition_id, value: @definition.id %>
      <%= form.hidden_field :recipient_identifier, value: @profile.handle %>
      <%= form.hidden_field :evidence_summary, value: @award.evidence_summary %>
      <%= form.hidden_field :expires_at, value: @award.expires_at %>
      <%= form.submit "Create invitation", class: "pu-btn pu-btn-md pu-btn-primary", data: {turbo_confirm: "Create this credential invitation and email #{@profile.name}?"} %>
    <% end %>
  <% end %>
</div>
