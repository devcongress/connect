<% content_for :title, @award.definition.name %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><%= link_to "← Credentials", credential_awards_path, class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %><h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]"><%= @award.definition.name %></h1><p class="mt-1 text-[var(--pu-text-muted)]"><%= @award.recipient_name %> · <span class="font-mono text-sm"><%= @award.public_id %></span></p></div>
    <div class="flex flex-wrap gap-2"><%= link_to "Correct details", edit_credential_award_path(@award), class: "pu-btn pu-btn-md pu-btn-outline" %><% if @award.publicly_verifiable? %><%= link_to "Open verification", main_app.public_credential_path(@award.public_id), target: "_blank", rel: "noopener", class: "pu-btn pu-btn-md pu-btn-primary" %><% end %></div>
  </header>

  <section class="pu-card"><div class="pu-card-body grid gap-5 sm:grid-cols-2"><div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Status</dt><dd class="mt-1"><span class="pu-badge <%= @award.active? ? "pu-badge-success" : (@award.pending_consent? ? "pu-badge-warning" : "pu-badge-neutral") %>"><%= @award.status.humanize %></span></dd></div><div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Recipient</dt><dd class="mt-1"><%= @award.recipient_name %> · @<%= @award.recipient.handle %></dd></div><div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Issued</dt><dd class="mt-1"><%= @award.issued_at&.to_fs(:long) || "Waiting for consent" %></dd></div><div><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Expires</dt><dd class="mt-1"><%= @award.expires_at&.to_fs(:long) || "Does not expire" %></dd></div><div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-[var(--pu-text-muted)]">Evidence</dt><dd class="mt-1"><%= @award.evidence_summary %></dd></div><% if @award.revoked? %><div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-red-600">Revocation reason</dt><dd class="mt-1"><%= @award.revoked_reason %></dd></div><% end %></div></section>

  <% if @award.active? %>
    <section class="grid gap-4 lg:grid-cols-2">
      <%= form_with url: revoke_credential_award_path(@award), class: "pu-card" do |form| %><div class="pu-card-body space-y-3"><h2 class="font-semibold text-[var(--pu-text)]">Revoke credential</h2><p class="text-sm text-[var(--pu-text-muted)]">The URL stays resolvable and displays the reason.</p><%= form.text_area :reason, required: true, rows: 2, placeholder: "Required reason", class: "w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %><%= form.submit "Revoke", class: "pu-btn pu-btn-md pu-btn-danger", data: {turbo_confirm: "Revoke this credential?"} %></div><% end %>
      <%= form_with url: expire_credential_award_path(@award), class: "pu-card" do |form| %><div class="pu-card-body space-y-3"><h2 class="font-semibold text-[var(--pu-text)]">Expire credential</h2><p class="text-sm text-[var(--pu-text-muted)]">Use for a credential that is no longer current but was valid when issued.</p><%= form.text_area :reason, required: true, rows: 2, placeholder: "Required reason", class: "w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %><%= form.submit "Mark expired", class: "pu-btn pu-btn-md pu-btn-outline", data: {turbo_confirm: "Mark this credential expired?"} %></div><% end %>
    </section>
  <% end %>

  <% if @award.expired? || @award.revoked? || @award.active? %>
    <%= form_with url: reissue_credential_award_path(@award), class: "pu-card" do |form| %><div class="pu-card-body flex flex-col gap-4 sm:flex-row sm:items-end"><div class="flex-1"><h2 class="font-semibold text-[var(--pu-text)]">Reissue</h2><p class="mt-1 text-sm text-[var(--pu-text-muted)]">Creates a new consent invitation linked to this record. An active credential is revoked first.</p><%= form.text_field :reason, required: true, placeholder: "Reason for reissue", class: "mt-3 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div><%= form.submit "Create replacement", class: "pu-btn pu-btn-md pu-btn-outline", data: {turbo_confirm: "Create a replacement credential invitation?"} %></div><% end %>
  <% end %>

  <section class="pu-card"><div class="pu-card-body"><h2 class="font-semibold text-[var(--pu-text)]">Audit trail</h2><ol class="mt-4 space-y-4"><% @award.events.each do |event| %><li class="border-l-2 border-[var(--pu-border)] pl-4"><p class="font-semibold text-[var(--pu-text)]"><%= event.event_type.humanize %></p><p class="text-xs text-[var(--pu-text-muted)]"><%= event.created_at.to_fs(:long) %> · <%= event.actor_label %></p><% if event.reason.present? %><p class="mt-1 text-sm text-[var(--pu-text-muted)]"><%= event.reason %></p><% end %></li><% end %></ol></div></section>
</div>
