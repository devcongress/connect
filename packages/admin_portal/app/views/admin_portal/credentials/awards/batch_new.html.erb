<% content_for :title, "Preview credential batch" %>
<div class="mx-auto max-w-4xl space-y-6">
  <header><%= link_to "← Credentials", credential_awards_path, class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %><h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]">Preview a credential batch</h1><p class="mt-1 text-sm text-[var(--pu-text-muted)]">The preview resolves recipients and detects current credentials. It creates nothing and sends no notifications.</p></header>
  <%= form_with url: preview_credential_batch_path, scope: :batch, class: "pu-card" do |form| %><div class="pu-card-body space-y-5"><div><%= form.label :definition_id, "Credential", class: "block font-semibold" %><%= form.collection_select :definition_id, @definitions, :id, :name, {}, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div><div><%= form.label :recipient_identifiers, "Recipients", class: "block font-semibold" %><%= form.text_area :recipient_identifiers, required: true, rows: 9, placeholder: "One developer handle or account email per line", class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2 font-mono" %></div><div><%= form.label :evidence_summary, "Evidence reviewed for every recipient", class: "block font-semibold" %><%= form.text_area :evidence_summary, required: true, rows: 4, placeholder: "Use a shared evidence statement only when it accurately applies to every recipient in this batch.", class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %><p class="mt-1 text-xs text-[var(--pu-text-muted)]">This summary becomes public for every consenting recipient. Do not include private contact details or internal notes.</p></div></div><div class="border-t border-[var(--pu-border)] px-6 py-4 text-right"><%= form.submit "Preview batch", class: "pu-btn pu-btn-md pu-btn-primary" %></div><% end %>
</div>
