<% content_for :title, "Credential batch preview" %>
<% issuable = @rows.select { |row| row[:profile] && !row[:existing] } %>
<div class="mx-auto max-w-5xl space-y-6">
  <header><%= link_to "← Change batch", new_credential_batch_path, class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %><h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]">Batch preview</h1><p class="mt-1 text-sm text-[var(--pu-text-muted)]"><%= issuable.size %> of <%= @rows.size %> recipients can receive a new <%= @definition.name %> invitation. Nothing has been created or sent.</p></header>
  <section class="pu-card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="border-b border-[var(--pu-border)] bg-[var(--pu-surface-alt)] text-xs uppercase tracking-wide text-[var(--pu-text-muted)]"><tr><th class="px-5 py-3">Input</th><th class="px-5 py-3">Resolved recipient</th><th class="px-5 py-3">Result</th></tr></thead><tbody class="divide-y divide-[var(--pu-border)]"><% @rows.each do |row| %><tr><td class="px-5 py-4 font-mono text-xs"><%= row[:identifier] %></td><td class="px-5 py-4"><%= row[:profile] ? "#{row[:profile].name} (@#{row[:profile].handle})" : "—" %></td><td class="px-5 py-4"><% if row[:profile].nil? %><span class="pu-badge pu-badge-danger">No matching profile</span><% elsif row[:existing] %><span class="pu-badge pu-badge-warning"><%= row[:existing].status.humanize %> credential exists</span><% else %><span class="pu-badge pu-badge-success">Ready</span><% end %></td></tr><% end %></tbody></table></div></section>
  <section class="pu-card"><div class="pu-card-body"><h2 class="font-semibold">Evidence applied to the batch</h2><p class="mt-2 text-sm text-[var(--pu-text-muted)]"><%= @evidence_summary %></p></div></section>
  <% if issuable.any? %>
    <%= form_with url: credential_batch_path, class: "text-right" do |form| %><%= hidden_field_tag :definition_id, @definition.id %><%= hidden_field_tag :evidence_summary, @evidence_summary %><% issuable.each do |row| %><%= hidden_field_tag "profile_ids[]", row[:profile].id %><% end %><%= hidden_field_tag :confirm, "issue" %><%= form.submit "Issue #{issuable.size} #{"invitation".pluralize(issuable.size)}", class: "pu-btn pu-btn-md pu-btn-primary", data: {turbo_confirm: "Create #{issuable.size} credential #{"invitation".pluralize(issuable.size)} and send recipient emails?"} %><% end %>
  <% end %>
</div>
