<% content_for :title, "Correct credential" %>
<div class="mx-auto max-w-3xl space-y-6">
  <header><%= link_to "← Credential", credential_award_path(@award), class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %><h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]">Correct credential details</h1><p class="mt-1 text-sm text-[var(--pu-text-muted)]">Every correction requires a reason and is preserved in the audit trail.</p></header>
  <%= form_with url: credential_award_path(@award), method: :patch, scope: :credential, class: "pu-card" do |form| %><div class="pu-card-body space-y-5"><div><%= form.label :recipient_name, class: "block font-semibold" %><%= form.text_field :recipient_name, value: @award.recipient_name, required: true, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div><div><%= form.label :evidence_summary, class: "block font-semibold" %><%= form.text_area :evidence_summary, value: @award.evidence_summary, required: true, rows: 5, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div><div><%= form.label :expires_at, class: "block font-semibold" %><%= form.datetime_local_field :expires_at, value: @award.expires_at, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div><div><%= label_tag :reason, "Correction reason", class: "block font-semibold" %><%= text_area_tag :reason, nil, required: true, rows: 3, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %></div></div><div class="border-t border-[var(--pu-border)] px-6 py-4 text-right"><%= form.submit "Save correction", class: "pu-btn pu-btn-md pu-btn-primary" %></div><% end %>
</div>
