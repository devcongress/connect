<% content_for :title, "Credentials" %>

<div class="mx-auto max-w-7xl space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-3xl text-[var(--pu-text)]">Credentials</h1>
      <p class="mt-1 text-sm text-[var(--pu-text-muted)]">Issue verifiable DevCongress credentials and manage their full lifecycle.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Export audit CSV", export_credential_awards_path, class: "pu-btn pu-btn-md pu-btn-outline" %>
      <%= link_to "Preview batch", new_credential_batch_path, class: "pu-btn pu-btn-md pu-btn-outline" %>
      <%= link_to "Issue credential", new_credential_award_path, class: "pu-btn pu-btn-md pu-btn-primary" %>
    </div>
  </header>

  <%= form_with url: credential_awards_path, method: :get, class: "pu-card" do |form| %>
    <div class="pu-card-body grid gap-4 sm:grid-cols-[1fr_220px_auto] sm:items-end">
      <div>
        <%= form.label :q, "Search", class: "block text-sm font-semibold text-[var(--pu-text)]" %>
        <%= form.search_field :q, value: @query, placeholder: "Name, email, handle, or credential ID", class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
      </div>
      <div>
        <%= form.label :status, class: "block text-sm font-semibold text-[var(--pu-text)]" %>
        <%= form.select :status, options_for_select([["All statuses", ""], *Credentials::Award.statuses.keys.map { |status| [status.humanize, status] }], @status), {}, class: "mt-1 w-full rounded-lg border border-[var(--pu-input-border)] bg-[var(--pu-surface)] px-3 py-2" %>
      </div>
      <%= form.submit "Filter", class: "pu-btn pu-btn-md pu-btn-outline" %>
    </div>
  <% end %>

  <section class="pu-card overflow-hidden">
    <% if @awards.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-[var(--pu-border)] bg-[var(--pu-surface-alt)] text-xs uppercase tracking-wide text-[var(--pu-text-muted)]">
            <tr><th class="px-5 py-3">Recipient</th><th class="px-5 py-3">Credential</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Created</th><th class="px-5 py-3"></th></tr>
          </thead>
          <tbody class="divide-y divide-[var(--pu-border)]">
            <% @awards.each do |award| %>
              <tr>
                <td class="px-5 py-4"><span class="block font-semibold text-[var(--pu-text)]"><%= award.recipient_name %></span><span class="text-xs text-[var(--pu-text-muted)]"><%= award.recipient.user.email %> · @<%= award.recipient.handle %></span></td>
                <td class="px-5 py-4"><%= award.definition.name %><span class="block font-mono text-xs text-[var(--pu-text-muted)]"><%= award.public_id %></span></td>
                <td class="px-5 py-4"><span class="pu-badge <%= award.active? ? "pu-badge-success" : (award.pending_consent? ? "pu-badge-warning" : "pu-badge-neutral") %>"><%= award.status.humanize %></span></td>
                <td class="px-5 py-4 text-[var(--pu-text-muted)]"><%= award.created_at.to_date.to_fs(:medium) %></td>
                <td class="px-5 py-4 text-right"><%= link_to "Review →", credential_award_path(award), class: "font-semibold text-primary-600 dark:text-primary-400" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="pu-card-body py-12 text-center text-sm text-[var(--pu-text-muted)]">No credentials match these filters.</div>
    <% end %>
  </section>
</div>
