<% content_for :title, "Credentials" %>
<div class="mx-auto max-w-5xl space-y-6">
  <header><h1 class="font-display text-3xl text-[var(--pu-text)]">Credentials</h1><p class="mt-1 text-sm text-[var(--pu-text-muted)]">Review credentials offered by DevCongress and manage the ones you have accepted.</p></header>
  <% if @awards.any? %>
    <ul class="grid gap-5 md:grid-cols-2">
      <% @awards.each do |award| %>
        <li class="dc-card overflow-hidden"><div class="dc-highlight border-b-2 border-[var(--dc-ink)] px-5 py-3 text-xs font-bold uppercase tracking-wide"><%= award.status.humanize %></div><div class="p-5"><div class="flex gap-4"><%= image_tag(award.pending_consent? ? "brand/devcongress-dev-square.png" : main_app.credential_badge_path(award.public_id, format: :svg), alt: award.definition.badge_alt_text, class: "h-24 w-24 rounded-xl border-2 border-[var(--dc-ink)]") %><div><h2 class="font-display text-2xl text-[var(--pu-text)]"><%= award.definition.name %></h2><p class="mt-1 text-sm text-[var(--pu-text-muted)]"><%= award.definition.short_description %></p></div></div><div class="mt-5 flex justify-end"><%= link_to(award.pending_consent? ? "Review invitation" : "View details", developers_profile_scoped_credential_award_path(developers_profile_scoped: @profile, id: award.public_id), class: "pu-btn pu-btn-sm pu-btn-primary") %></div></div></li>
      <% end %>
    </ul>
  <% else %>
    <section class="pu-card"><div class="pu-card-body py-12 text-center"><h2 class="font-semibold text-[var(--pu-text)]">No credentials yet</h2><p class="mt-2 text-sm text-[var(--pu-text-muted)]">When DevCongress reviews an eligible contribution, its credential invitation will appear here.</p></div></section>
  <% end %>
</div>
