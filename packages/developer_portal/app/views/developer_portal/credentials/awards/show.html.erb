<% content_for :title, @award.definition.name %>
<div class="mx-auto max-w-4xl space-y-6">
  <header><%= link_to "← Credentials", developers_profile_scoped_credential_awards_path(developers_profile_scoped: @profile), class: "text-sm font-semibold text-primary-600 dark:text-primary-400" %><h1 class="mt-3 font-display text-3xl text-[var(--pu-text)]"><%= @award.definition.name %></h1><p class="mt-1 text-sm text-[var(--pu-text-muted)]">Issued by DevCongress · criteria <%= @award.criteria_version %></p></header>
  <section class="dc-card overflow-hidden"><div class="dc-highlight border-b-2 border-[var(--dc-ink)] px-6 py-4 text-sm font-bold uppercase tracking-wide"><%= @award.status.humanize %></div><div class="grid gap-6 p-6 sm:grid-cols-[180px_1fr]"><%= image_tag(@award.pending_consent? ? "brand/devcongress-dev-square.png" : main_app.credential_badge_path(@award.public_id, format: :svg), alt: @award.definition.badge_alt_text, class: "aspect-square w-full rounded-2xl border-2 border-[var(--dc-ink)]") %><div><h2 class="font-display text-4xl"><%= @award.recipient_name %></h2><p class="mt-3 text-[var(--pu-text-muted)]"><%= @award.definition.description %></p><dl class="mt-5 space-y-4 text-sm"><div><dt class="font-semibold uppercase tracking-wide text-[var(--pu-text-muted)]">Eligibility criteria</dt><dd class="mt-1"><%= simple_format(@award.definition.eligibility_criteria) %></dd></div><div><dt class="font-semibold uppercase tracking-wide text-[var(--pu-text-muted)]">Evidence reviewed</dt><dd class="mt-1"><%= @award.evidence_summary %></dd></div><div><dt class="font-semibold uppercase tracking-wide text-[var(--pu-text-muted)]">What it does not prove</dt><dd class="mt-1"><%= @award.definition.does_not_prove %></dd></div></dl></div></div></section>
  <% if @award.pending_consent? %>
    <section class="pu-card"><div class="pu-card-body space-y-4"><h2 class="text-xl font-semibold text-[var(--pu-text)]">Your consent</h2><p class="text-sm font-semibold text-[var(--pu-text)]">Nothing becomes public until you accept.</p><p class="text-sm text-[var(--pu-text-muted)]">Accepting publishes your name, the credential, the issue date, its criteria version, the evidence summary above, status, and credential ID at a stable verification URL. Your email and private profile information remain private.</p><p class="text-sm text-[var(--pu-text-muted)]">Adding it to LinkedIn is optional and does not require connecting your LinkedIn account.</p><%= button_to "Accept and issue credential", developers_profile_scoped_accept_credential_award_path(developers_profile_scoped: @profile, id: @award.public_id), class: "pu-btn pu-btn-md pu-btn-primary", data: {turbo_confirm: "Accept this credential and publish its verification page?"} %></div></section>
  <% else %>
    <div class="flex justify-end"><%= link_to "Open public verification page", main_app.public_credential_path(@award.public_id), class: "pu-btn pu-btn-md pu-btn-primary" %></div>
  <% end %>
</div>
